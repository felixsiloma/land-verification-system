<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="10dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg"
        android:padding="10dp">

        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/img"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:src="@drawable/house" />

        <LinearLayout
            android:id="@+id/one"
            android:layout_width="match_parent"
            android:orientation="horizontal"
            android:layout_height="wrap_content"
            android:layout_toRightOf="@+id/img">


            <TextView
                android:id="@+id/locatn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:layout_toRightOf="@+id/img"
                android:text="Land Location :"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/location_adapt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="5dp"
                android:layout_toRightOf="@+id/locatn"
                android:text="Location"
                android:textColor="@color/white" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/two"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/one"
            android:orientation="horizontal"
            android:layout_toRightOf="@+id/img">

            <TextView
                android:id="@+id/typo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/locatn"
                android:layout_marginLeft="20dp"
                android:layout_toRightOf="@+id/img"
                android:text="Land Size :"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/size_adapt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/location_adapt"
                android:layout_marginLeft="45dp"
                android:layout_toRightOf="@+id/typo"
                android:text="size"
                android:textColor="@color/white" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/three"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/two"
            android:orientation="horizontal"
            android:layout_toRightOf="@+id/img">


            <TextView
                android:id="@+id/roomsmain"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/typo"
                android:layout_marginLeft="20dp"
                android:layout_toRightOf="@+id/img"
                android:text="Email:"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/email_adapt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/size_adapt"
                android:layout_marginLeft="5dp"
                android:layout_toRightOf="@+id/roomsmain"
                android:text="email"
                android:textColor="@color/white" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/four"
            android:layout_below="@+id/three"
            android:orientation="horizontal"
            android:layout_toRightOf="@+id/img">


            <TextView
                android:id="@+id/rentmain"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/roomsmain"
                android:layout_marginLeft="20dp"
                android:layout_toRightOf="@+id/img"
                android:text="Land Price Ksh :"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/price_adapt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/email_adapt"
                android:layout_marginLeft="5dp"
                android:layout_toRightOf="@+id/rentmain"
                android:text="price"
                android:textColor="@color/white" />
        </LinearLayout>
        <TextView
            android:id="@+id/url_adapt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="5dp"
            android:visibility="gone"
            android:layout_below="@+id/four"
            android:layout_toRightOf="@+id/img"
            android:text="url"
            android:textColor="@color/white" />
    </RelativeLayout>

</LinearLayout>